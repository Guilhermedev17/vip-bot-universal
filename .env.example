# =====================================================================
#  Copie para .env e preencha com os SEUS dados. Nunca commite o .env.
#  Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# =====================================================================

# --- Marca ---
# Nome exibido nos textos do bot (pitch, nudges, avisos, cobrança).
BRAND_NAME=VIP 2026

# --- Telegram ---
# Token do bot criado no @BotFather (/newbot)
BOT_TOKEN=
# Segredo pra validar os updates do Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Gere um valor aleatório forte e use o MESMO ao configurar o webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Canal VIP ---
# ID numérico do canal/grupo privado (ex: -1003739284829).
# O bot precisa ser ADMINISTRADOR do canal (com permissão de convidar).
VIP_CHANNEL_ID=

# --- URL pública (produção) ---
# URL pública do app com HTTPS, ex: https://meubot.vercel.app
PUBLIC_URL=

# --- Epague ---
# Chave de API gerada no painel da Epague.
# Crie a chave SOMENTE com a permissão "Cobranças" (sem "Saques").
EPAGUE_API_KEY=
# Secret do webhook (Dashboard / Integrações / Webhooks) — valida a assinatura HMAC.
EPAGUE_WEBHOOK_SECRET=
# (opcional) URL base da API. Padrão: https://epague.net
# EPAGUE_BASE_URL=https://epague.net

# --- Banco de dados (Turso) ---
# Crie em https://turso.tech — plano gratuito basta.
TURSO_URL=libsql://seu-banco-regiao.turso.io
TURSO_TOKEN=

# --- Cron de expiração ---
# Segredo Bearer do endpoint /cron/expire (gere um valor aleatório forte).
CRON_SECRET=

# --- Opcionais ---
# Contato exibido no /suporte (ex: @seu_suporte ou link do Telegram)
SUPPORT_CONTACT=
# Vídeo de boas-vindas no /start (file_id, URL ou caminho). Vazio = não envia.
WELCOME_VIDEO=
# Planos em JSON. Se vazio, usa os padrões de config.py.
# PLANS_JSON=[{"id":"semanal","name":"Plano Semanal","price_cents":999,"description":"7 dias","days":7}]
PLANS_JSON=

# --- Promoções (opcional, desligado por padrão) ---
# PROMO_ACTIVE=1 ativa; PROMO_DISCOUNT é a fração (0.5 = 50% OFF); PROMO_NAME o rótulo.
# PROMO_ACTIVE=
# PROMO_DISCOUNT=
# PROMO_NAME=

# --- Servidor local ---
PORT=5000
